{
  "command": "detect",
  "params": {
    "sop_project_dir": "projects/SK_DEMO",
    "video_path": "videos/sk.mp4",
    "output_dir": "outputs/wpf_detect_test",
    "hand_pose_model_path": "models/hand_landmarker.task",
    "enable_hand_pose": true,
    "hand_pose_active_step_only": false,
    "vision_inference_interval_frames": 2,
    "enable_yolo": true,
    "confidence_threshold": 0.25,
    "nms_threshold": 0.7,
    "inference_backend": "python",
    "hand_pose_sample_interval": 1,
    "tracking_iou_threshold": 0.3,
    "tracking_max_missing_frames": 8,
    "tracking_min_confirmed_hits": 1,
    "tracking_low_confidence": 0.1,
    "tracking_new_track_confidence": 0.6,
    "tracking_second_match_iou_threshold": 0.2,
    "event_lost_tolerance_frames": 8,
    "output_video": true,
    "output_json": true,
    "realtime_display": false
  }
}
