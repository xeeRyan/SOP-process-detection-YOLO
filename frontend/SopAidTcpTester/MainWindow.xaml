<Window x:Class="SopAidTcpTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SOPAID 多流程工作台 · 前端联调 Demo"
        Width="1380" Height="900" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#F3F6FA">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D8E0EA" />
        <Style TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#526173" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#172033" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="230" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#12213A" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="SOPAID" Foreground="White" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="多 SOP 配置、数据、训练与检测联调" Foreground="#AFC0D8" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Host" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBox x:Name="HostTextBox" Text="127.0.0.1" Width="145" />
                    <TextBlock Text="Port" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="12,0,7,0" />
                    <TextBox x:Name="PortTextBox" Text="9000" Width="80" />
                    <Button x:Name="HealthButton" Content="检查服务" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Click="HealthButton_Click" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ServiceIndicator" Width="10" Height="10" Fill="#94A3B8" Margin="0,0,7,0" />
                    <TextBlock x:Name="ServiceStatusText" Text="未连接" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,14,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="运行环境" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="算法包 / 源码根目录" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="PackageRootTextBox" Margin="0,0,0,10" />
                    <WrapPanel Margin="0,0,0,18">
                        <Button x:Name="BrowseRootButton" Content="选择目录" Click="BrowseRootButton_Click" />
                        <Button x:Name="StartServerButton" Content="启动算法服务" Click="StartServerButton_Click" />
                        <Button x:Name="CloseServerButton" Content="停止" Click="CloseServerButton_Click" />
                    </WrapPanel>

                    <TextBlock Text="当前 SOP 项目" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ProjectDirTextBox" Text="projects/SK_DEMO" Margin="0,0,0,8" />
                    <WrapPanel Margin="0,0,0,14">
                        <Button x:Name="BrowseProjectButton" Content="选择项目" Click="BrowseProjectButton_Click" />
                        <Button x:Name="GetProjectButton" Content="读取项目" Click="GetProjectButton_Click" />
                    </WrapPanel>

                    <Border Background="#EFF6FF" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="当前状态" FontWeight="SemiBold" Foreground="#1E3A8A" />
                            <TextBlock x:Name="CurrentProjectText" Text="SK_DEMO" FontSize="17" FontWeight="Bold" Margin="0,5,0,0" />
                            <TextBlock x:Name="ProjectStateText" Text="等待读取项目信息" Foreground="#526173" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <TabControl x:Name="WorkflowTabs" Background="White" BorderThickness="0">
                    <TabItem Header="① 项目">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20">
                                <TextBlock Text="SOP 项目管理" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="项目 ID" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="NewProjectIdTextBox" Text="SOP_002" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="项目名称" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="NewProjectNameTextBox" Text="新装配流程" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="项目描述" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                <TextBox x:Name="ProjectDescriptionTextBox" Text="操作员创建的新 SOP 项目" />
                                <TextBlock Text="识别类别（每行：英文名|显示名称）" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                <TextBox x:Name="ClassesTextBox" Height="105" AcceptsReturn="True" FontFamily="Consolas" Text="part_a|零件 A&#x0a;tool|工具" />
                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="ListProjectsButton" Content="刷新项目列表" Click="ListProjectsButton_Click" />
                                    <Button x:Name="CreateProjectButton" Content="创建草稿项目" Style="{StaticResource PrimaryButton}" Click="CreateProjectButton_Click" />
                                    <Button x:Name="ActivateProjectButton" Content="校验并激活" Click="ActivateProjectButton_Click" />
                                </WrapPanel>
                                <TextBlock Text="项目列表" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
                                <ListBox x:Name="ProjectsListBox" Height="130" SelectionChanged="ProjectsListBox_SelectionChanged" DisplayMemberPath="DisplayName" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="② 数据准备">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20">
                                <TextBlock Text="视频抽帧与外部标注回导" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="流程视频（每行一个路径）" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="VideoPathsTextBox" Height="72" AcceptsReturn="True" FontFamily="Consolas" Text="videos/sk.mp4" />
                                    <Button Grid.Column="1" Content="选择视频" Margin="10,0,0,0" Click="BrowseVideosButton_Click" />
                                </Grid>
                                <WrapPanel Margin="0,12,0,0">
                                    <StackPanel Width="150" Margin="0,0,12,0"><TextBlock Text="每秒抽帧数" Style="{StaticResource FieldLabel}" /><TextBox x:Name="FramesPerSecondTextBox" Text="2" /></StackPanel>
                                    <StackPanel Width="170" Margin="0,0,12,0"><TextBlock Text="每视频最大张数" Style="{StaticResource FieldLabel}" /><TextBox x:Name="MaxFramesTextBox" Text="300" /></StackPanel>
                                    <CheckBox x:Name="CopyVideosCheckBox" Content="复制源视频到项目" IsChecked="True" VerticalAlignment="Bottom" Margin="4,0,0,8" />
                                </WrapPanel>
                                <Button x:Name="ExtractFramesButton" Content="开始导入并抽帧" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ExtractFramesButton_Click" />
                                <Separator Margin="0,18" />
                                <TextBlock Text="外部 YOLO 标签目录" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="LabelsDirTextBox" Text="data\labels" />
                                    <Button Grid.Column="1" Content="选择目录" Margin="10,0,0,0" Click="BrowseLabelsButton_Click" />
                                </Grid>
                                <WrapPanel Margin="0,12,0,0">
                                    <CheckBox x:Name="OverwriteLabelsCheckBox" Content="覆盖已有标签" IsChecked="True" Margin="0,0,18,0" />
                                    <CheckBox x:Name="MissingAsEmptyCheckBox" Content="缺失标签视为空样本（谨慎）" />
                                </WrapPanel>
                                <Button x:Name="ImportLabelsButton" Content="导入并校验标注" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ImportLabelsButton_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="③ ROI 与步骤">
                        <Grid Margin="16">
                            <Grid.RowDefinitions><RowDefinition Height="3*" /><RowDefinition Height="12" /><RowDefinition Height="2*" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="抽帧图片可视化框选" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left" />
                                        <Button Content="选择抽帧图片" HorizontalAlignment="Right" Click="BrowseRoiImageButton_Click" />
                                    </DockPanel>
                                    <Border Grid.Row="1" Background="#111827" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                        <Grid x:Name="RoiImageHost" SizeChanged="RoiImageHost_SizeChanged">
                                            <Image x:Name="RoiSourceImage" Stretch="Uniform" />
                                            <Canvas x:Name="RoiOverlayCanvas" Background="Transparent" MouseLeftButtonDown="RoiCanvas_MouseLeftButtonDown" MouseMove="RoiCanvas_MouseMove" MouseLeftButtonUp="RoiCanvas_MouseLeftButtonUp" />
                                            <TextBlock x:Name="RoiImagePlaceholder" Text="请选择项目 frames 目录下的抽帧图片" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="2" x:Name="RoiImageInfoText" Text="未加载图片" Foreground="#64748B" Margin="0,6,0,0" />
                                </Grid>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="区域属性" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="ROI ID（步骤中的 roi_id）" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="RoiIdTextBox" Text="work" />
                                    <TextBlock Text="显示名称" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
                                    <TextBox x:Name="RoiNameTextBox" Text="主工作区" />
                                    <TextBlock Text="在左侧图片按住鼠标拖动，松开后会弹出命名窗口。这里的内容作为弹窗默认值；确认后自动新增或更新同 ID 区域。" TextWrapping="Wrap" Foreground="#475569" Margin="0,10,0,10" />
                                    <ListBox x:Name="RoiRegionsListBox" MinHeight="90" SelectionChanged="RoiRegionsListBox_SelectionChanged" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="删除选中区域" Click="DeleteSelectedRoiButton_Click" />
                                        <Button Content="从 JSON 刷新画面" Click="RefreshRoiCanvasButton_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="ROI JSON（自动生成，可手动调整）" Style="{StaticResource SectionTitle}" />
                                    <TextBox Grid.Row="1" x:Name="RoisJsonTextBox" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                                        <Button Content="载入示例" Click="LoadRoiSampleButton_Click" />
                                        <Button x:Name="SaveRoisButton" Content="保存到 rois.json" Style="{StaticResource PrimaryButton}" Click="SaveRoisButton_Click" />
                                    </WrapPanel>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <DockPanel>
                                        <TextBlock Text="可视化流程步骤" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left" />
                                        <WrapPanel HorizontalAlignment="Right">
                                            <Button Content="＋ 新增" Click="AddWorkflowStepButton_Click" />
                                            <Button Content="↑" ToolTip="上移" Click="MoveWorkflowStepUpButton_Click" />
                                            <Button Content="↓" ToolTip="下移" Click="MoveWorkflowStepDownButton_Click" />
                                            <Button Content="删除" Click="DeleteWorkflowStepButton_Click" />
                                        </WrapPanel>
                                    </DockPanel>
                                    <DataGrid Grid.Row="1" x:Name="WorkflowStepsDataGrid" ItemsSource="{Binding WorkflowSteps}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" Margin="0,6,0,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding Order}" IsReadOnly="True" Width="34" />
                                            <DataGridTextColumn Header="步骤 ID" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                            <DataGridTextColumn Header="步骤名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                            <DataGridTemplateColumn Header="触发方式" Width="110">
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding TriggerType}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.TriggerTypes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding TriggerType, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="识别类别" Width="95">
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ClassName}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.AvailableClassNames, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="ROI" Width="85">
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding RoiId}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.AvailableRoiIds, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding RoiId, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="对象事件" Width="115">
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding EventType}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.EventTypes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding EventType, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="置信度" Binding="{Binding Confidence, UpdateSourceTrigger=PropertyChanged}" Width="65" />
                                            <DataGridTextColumn Header="稳定帧" Binding="{Binding StableFrames, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                            <DataGridTextColumn Header="超时(s)" Binding="{Binding TimeoutSec, UpdateSourceTrigger=PropertyChanged}" Width="62" />
                                            <DataGridCheckBoxColumn Header="必需" Binding="{Binding Required}" Width="45" />
                                            <DataGridCheckBoxColumn Header="允许手势" Binding="{Binding AllowHandPose}" Width="65" />
                                            <DataGridTextColumn Header="高级触发 JSON" Binding="{Binding AdvancedTriggerJson, UpdateSourceTrigger=PropertyChanged}" Width="260" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Expander Grid.Row="2" Header="高级：workflow.json" Margin="0,6,0,0">
                                        <Grid Height="105">
                                            <TextBox x:Name="WorkflowJsonTextBox" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                        </Grid>
                                    </Expander>
                                    <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                                        <Button Content="载入示例" Click="LoadWorkflowSampleButton_Click" />
                                        <Button Content="从 JSON 载入表格" Click="LoadWorkflowTableButton_Click" />
                                        <Button x:Name="SaveWorkflowButton" Content="生成并保存流程" Style="{StaticResource PrimaryButton}" Click="SaveWorkflowButton_Click" />
                                    </WrapPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="④ 数据集与训练">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20">
                                <TextBlock Text="数据集构建" Style="{StaticResource SectionTitle}" />
                                <WrapPanel>
                                    <StackPanel Width="240" Margin="0,0,12,0"><TextBlock Text="数据集名称" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="DatasetNameComboBox" IsEditable="True" /></StackPanel>
                                    <StackPanel Width="110" Margin="0,0,12,0"><TextBlock Text="训练比例" Style="{StaticResource FieldLabel}" /><TextBox x:Name="TrainRatioTextBox" Text="0.7" /></StackPanel>
                                    <StackPanel Width="110" Margin="0,0,12,0"><TextBlock Text="验证比例" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ValRatioTextBox" Text="0.2" /></StackPanel>
                                    <StackPanel Width="110"><TextBlock Text="测试比例" Style="{StaticResource FieldLabel}" /><TextBox x:Name="TestRatioTextBox" Text="0.1" /></StackPanel>
                                </WrapPanel>
                                <Button x:Name="BuildDatasetButton" Content="按视频构建数据集" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="BuildDatasetButton_Click" />
                                <Separator Margin="0,18" />
                                <TextBlock Text="项目模型训练（同步任务，可能耗时较长）" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="模型 ID" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ModelIdTextBox" Text="sop_detector" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="模型版本" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ModelVersionTextBox" Text="1.0.0" /></StackPanel>
                                </Grid>
                                <TextBlock Text="基础模型路径（留空使用项目活动模型）" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                <TextBox x:Name="BaseModelTextBox" Text="models/yolo26n.pt" />
                                <WrapPanel Margin="0,12,0,0">
                                    <StackPanel Width="110" Margin="0,0,12,0"><TextBlock Text="Epochs" Style="{StaticResource FieldLabel}" /><TextBox x:Name="EpochsTextBox" Text="100" /></StackPanel>
                                    <StackPanel Width="110" Margin="0,0,12,0"><TextBlock Text="Batch" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BatchTextBox" Text="8" /></StackPanel>
                                    <StackPanel Width="110" Margin="0,0,12,0"><TextBlock Text="Image Size" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ImageSizeTextBox" Text="640" /></StackPanel>
                                    <StackPanel Width="110" Margin="0,0,12,0"><TextBlock Text="Workers" Style="{StaticResource FieldLabel}" /><TextBox x:Name="WorkersTextBox" Text="0" /></StackPanel>
                                    <StackPanel Width="130" Margin="0,0,12,0"><TextBlock Text="Device" Style="{StaticResource FieldLabel}" /><TextBox x:Name="DeviceTextBox" ToolTip="例如 0、0,1、cpu；留空自动选择" /></StackPanel>
                                    <StackPanel Width="130"><TextBlock Text="Optimizer" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="OptimizerComboBox" IsEditable="True" Text="auto"><ComboBoxItem Content="auto" /><ComboBoxItem Content="SGD" /><ComboBoxItem Content="Adam" /><ComboBoxItem Content="AdamW" /></ComboBox></StackPanel>
                                </WrapPanel>
                                <WrapPanel Margin="0,10,0,0">
                                    <StackPanel Width="210" Margin="0,0,12,0"><TextBlock Text="运行名称（留空自动生成）" Style="{StaticResource FieldLabel}" /><TextBox x:Name="RunNameTextBox" /></StackPanel>
                                    <CheckBox x:Name="AmpCheckBox" Content="AMP 混合精度" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,18,8" />
                                    <CheckBox x:Name="SetActiveModelCheckBox" Content="训练后设为活动模型" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                                </WrapPanel>
                                <Expander Header="数据增强参数（空值使用 YOLO 默认值）" Margin="0,12,0,0">
                                    <WrapPanel Margin="8">
                                        <StackPanel Width="105" Margin="0,0,8,8"><TextBlock Text="hsv_h" /><TextBox x:Name="HsvHTextBox" /></StackPanel>
                                        <StackPanel Width="105" Margin="0,0,8,8"><TextBlock Text="hsv_s" /><TextBox x:Name="HsvSTextBox" /></StackPanel>
                                        <StackPanel Width="105" Margin="0,0,8,8"><TextBlock Text="hsv_v" /><TextBox x:Name="HsvVTextBox" /></StackPanel>
                                        <StackPanel Width="105" Margin="0,0,8,8"><TextBlock Text="degrees" /><TextBox x:Name="DegreesTextBox" /></StackPanel>
                                        <StackPanel Width="105" Margin="0,0,8,8"><TextBlock Text="translate" /><TextBox x:Name="TranslateTextBox" /></StackPanel>
                                        <StackPanel Width="105" Margin="0,0,8,8"><TextBlock Text="scale" /><TextBox x:Name="ScaleTextBox" /></StackPanel>
                                        <StackPanel Width="105" Margin="0,0,8,8"><TextBlock Text="shear" /><TextBox x:Name="ShearTextBox" /></StackPanel>
                                        <StackPanel Width="105" Margin="0,0,8,8"><TextBlock Text="fliplr" /><TextBox x:Name="FlipLrTextBox" /></StackPanel>
                                        <StackPanel Width="105" Margin="0,0,8,8"><TextBlock Text="flipud" /><TextBox x:Name="FlipUdTextBox" /></StackPanel>
                                        <StackPanel Width="105" Margin="0,0,8,8"><TextBlock Text="mosaic" /><TextBox x:Name="MosaicTextBox" /></StackPanel>
                                        <StackPanel Width="105" Margin="0,0,8,8"><TextBlock Text="mixup" /><TextBox x:Name="MixupTextBox" /></StackPanel>
                                        <StackPanel Width="105" Margin="0,0,8,8"><TextBlock Text="copy_paste" /><TextBox x:Name="CopyPasteTextBox" /></StackPanel>
                                    </WrapPanel>
                                </Expander>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="TrainProjectButton" Content="启动项目训练" Style="{StaticResource PrimaryButton}" Click="TrainProjectButton_Click" />
                                    <Button x:Name="StopTrainingButton" Content="完成当前轮后停止" IsEnabled="False" Margin="10,0,0,0" Click="StopTrainingButton_Click" />
                                </WrapPanel>
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock x:Name="TrainingProgressText" Text="尚未开始训练" Style="{StaticResource FieldLabel}" />
                                    <ProgressBar x:Name="TrainingProgressBar" Height="16" Minimum="0" Maximum="100" Value="0" />
                                </StackPanel>
                                <Separator Margin="0,18" />
                                <TextBlock Text="训练后模型转换" Style="{StaticResource SectionTitle}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="选择已训练模型" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="ConversionModelComboBox" MinWidth="360" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="刷新模型" VerticalAlignment="Bottom" Click="RefreshConversionModelsButton_Click" />
                                </Grid>
                                <WrapPanel Margin="0,12,0,0">
                                    <CheckBox x:Name="ExportTorchScriptCheckBox" Content="TorchScript" IsChecked="True" Margin="0,0,16,8" />
                                    <CheckBox x:Name="ExportOnnxCheckBox" Content="ONNX" IsChecked="True" Margin="0,0,16,8" />
                                    <CheckBox x:Name="ExportEngineCheckBox" Content="TensorRT Engine" Margin="0,0,16,8" />
                                    <CheckBox x:Name="ConversionOverwriteCheckBox" Content="覆盖已有转换文件" Margin="8,0,0,8" />
                                </WrapPanel>
                                <Button x:Name="ConvertProjectModelButton" Content="转换所选模型格式" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ConvertProjectModelButton_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="⑤ 视频检测">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="20">
                                <TextBlock Text="使用当前 SOP 项目检测流程视频" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="输入视频" Style="{StaticResource FieldLabel}" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="DetectVideoTextBox" Text="videos/sk.mp4" /><Button Grid.Column="1" Content="选择视频" Margin="10,0,0,0" Click="BrowseDetectVideoButton_Click" /></Grid>
                                <TextBlock Text="项目内相对输出目录" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                <TextBox x:Name="DetectOutputTextBox" Text="outputs/frontend_detect" />
                                <TextBlock Text="检测模型（自动读取当前项目 models 目录）" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="DetectModelComboBox" IsEditable="False" IsTextSearchEnabled="True" MinHeight="30" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1" Content="刷新模型" Margin="10,0,0,0" Click="RefreshModelsButton_Click" />
                                    <Button Grid.Column="2" Content="浏览模型" Margin="8,0,0,0" Click="BrowseDetectModelButton_Click" />
                                </Grid>
                                <WrapPanel Margin="0,12,0,0">
                                    <StackPanel Width="130" Margin="0,0,12,0"><TextBlock Text="置信度" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ConfidenceTextBox" Text="0.25" /></StackPanel>
                                    <StackPanel Width="130" Margin="0,0,12,0"><TextBlock Text="NMS 阈值" Style="{StaticResource FieldLabel}" /><TextBox x:Name="NmsThresholdTextBox" Text="0.7" /></StackPanel>
                                    <StackPanel Width="130" Margin="0,0,12,0"><TextBlock Text="推理设备" Style="{StaticResource FieldLabel}" /><ComboBox x:Name="InferenceDeviceComboBox" SelectedIndex="0"><ComboBoxItem Content="auto" /><ComboBoxItem Content="cpu" /><ComboBoxItem Content="0" /></ComboBox></StackPanel>
                                    <StackPanel Width="160" Margin="0,0,12,0"><TextBlock Text="手部推理间隔（帧）" Style="{StaticResource FieldLabel}" /><TextBox x:Name="HandPoseIntervalTextBox" Text="1" ToolTip="设为 1 时逐帧运行手部模型" /></StackPanel>
                                    <StackPanel Width="160" Margin="0,0,12,0"><TextBlock Text="视觉推理间隔（帧）" Style="{StaticResource FieldLabel}" /><TextBox x:Name="VisionIntervalTextBox" Text="2" ToolTip="跳过帧使用跟踪预测和缓存结果" /></StackPanel>
                                    <CheckBox x:Name="EnableYoloCheckBox" Content="启用 YOLO" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,16,8" />
                                    <CheckBox x:Name="EnableHandPoseCheckBox" Content="启用手部关键点" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,16,8" />
                                    <CheckBox x:Name="HandPoseActiveStepOnlyCheckBox" Content="仅在当前步骤需要时运行手部模型" IsChecked="False" VerticalAlignment="Bottom" Margin="0,0,16,8" />
                                    <CheckBox x:Name="OutputVideoCheckBox" Content="输出结果视频" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,16,8" />
                                    <CheckBox x:Name="OutputJsonCheckBox" Content="输出 JSON" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                                </WrapPanel>
                                <TextBlock Text="目标类别（逗号分隔；留空使用项目全部类别）" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
                                <TextBox x:Name="TargetClassesTextBox" />
                                <TextBlock Text="手部关键点模型路径" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
                                <TextBox x:Name="HandPoseModelTextBox" Text="models/hand_landmarker.task" />
                                <CheckBox x:Name="RealtimeDisplayCheckBox" Content="实时显示 OpenCV 窗口（桌面调试）" Margin="0,10,0,0" />
                                <Expander Header="步骤运行覆盖参数（JSON，可留空）" Margin="0,10,0,0">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="步骤启用状态，例如 { &quot;step_001&quot;: true }" />
                                        <TextBox x:Name="StepEnabledJsonTextBox" AcceptsReturn="True" Height="54" FontFamily="Consolas" />
                                        <WrapPanel Margin="0,10,0,0">
                                            <StackPanel Width="160" Margin="0,0,12,0">
                                                <TextBlock Text="推理接口" />
                                                <ComboBox x:Name="InferenceBackendComboBox" SelectedIndex="0">
                                                    <ComboBoxItem Content="python" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Width="150" Margin="0,0,12,0">
                                                <TextBlock Text="跟踪 IoU 阈值" />
                                                <TextBox x:Name="TrackingIouTextBox" Text="0.2" />
                                            </StackPanel>
                                            <StackPanel Width="170" Margin="0,0,12,0">
                                                <TextBlock Text="跟踪最大丢失帧" />
                                                <TextBox x:Name="TrackingMissingTextBox" Text="8" />
                                            </StackPanel>
                                            <StackPanel Width="180">
                                                <TextBlock Text="事件丢失容忍帧" />
                                                <TextBox x:Name="EventLostToleranceTextBox" Text="8" ToolTip="连续漏检超过此帧数后才产生离开和消失事件" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock Text="触发来源，例如 { &quot;step_001&quot;: &quot;yolo&quot; }" Margin="0,8,0,0" />
                                        <TextBox x:Name="TriggerSourcesJsonTextBox" AcceptsReturn="True" Height="54" FontFamily="Consolas" />
                                        <TextBlock Text="步骤超时秒数，例如 { &quot;step_001&quot;: 30 }" Margin="0,8,0,0" />
                                        <TextBox x:Name="StepTimeoutsJsonTextBox" AcceptsReturn="True" Height="54" FontFamily="Consolas" />
                                    </StackPanel>
                                </Expander>
                                <Button x:Name="DetectButton" Content="开始检测" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="DetectButton_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="高级 JSON">
                        <Grid Margin="20">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="Health" Click="LoadHealthButton_Click" />
                                <Button Content="读取项目" Click="LoadGetProjectButton_Click" />
                                <Button Content="检测" Click="LoadDetectButton_Click" />
                                <Button x:Name="SendJsonButton" Content="发送 JSON" Style="{StaticResource PrimaryButton}" Click="SendJsonButton_Click" />
                            </WrapPanel>
                            <TextBox Grid.Row="1" x:Name="RequestTextBox" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="16,0,16,8" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="接口响应与运行日志" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="清空" DockPanel.Dock="Right" Click="ClearButton_Click" />
                </DockPanel>
                <TextBox Grid.Row="1" x:Name="ResponseTextBox" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="#E7EDF5" Padding="16,7">
            <TextBlock x:Name="StatusTextBlock" Text="就绪" Foreground="#526173" />
        </Border>
    </Grid>
</Window>
