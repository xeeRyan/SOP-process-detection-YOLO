<Window x:Class="SopAidTcpTester.RoiNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="命名 ROI 区域" Width="420" Height="250"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="圈选完成，请为该区域命名" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14" />
        <TextBlock Grid.Row="1" Text="ROI ID（流程步骤中的 roi_id）" Foreground="#475569" Margin="0,0,0,5" />
        <TextBox Grid.Row="2" x:Name="RoiIdInput" Height="30" VerticalContentAlignment="Center" />
        <TextBlock Grid.Row="3" Text="显示名称" Foreground="#475569" Margin="0,12,0,5" />
        <TextBox Grid.Row="4" x:Name="RoiNameInput" Height="30" VerticalAlignment="Top" VerticalContentAlignment="Center" />
        <DockPanel Grid.Row="5" Margin="0,18,0,0" LastChildFill="False">
            <TextBlock x:Name="ValidationText" Foreground="#DC2626" VerticalAlignment="Center" DockPanel.Dock="Left" />
            <Button Content="取消" Width="76" Margin="8,0,0,0" IsCancel="True" DockPanel.Dock="Right" />
            <Button Content="确认" Width="76" Margin="8,0,0,0" IsDefault="True" Click="ConfirmButton_Click" DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>
</Window>
