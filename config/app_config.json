{
  "tcp": {
    "host": "0.0.0.0",
    "port": 9000
  },
  "paths": {
    "video_path": "videos/sk.mp4",
    "output_dir": "outputs/yolo26s",
    "hand_pose_model_path": "models/hand_landmarker.task"
  },
  "hand_pose": {
    "enabled": true,
    "sample_interval": 1
  },
  "tracking": {
    "iou_threshold": 0.2,
    "max_missing_frames": 8,
    "event_lost_tolerance_frames": 8
  },
  "ai": {
    "enable_yolo": true,
    "inference_backend": "python",
    "confidence_threshold": 0.25,
    "nms_threshold": 0.7,
    "target_classes": [
      "bearing",
      "cover",
      "tool"
    ]
  },
  "output": {
    "output_video": true,
    "output_json": true,
    "realtime_display": false
  }
}
