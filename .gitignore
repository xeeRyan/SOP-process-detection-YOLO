# Python runtime cache
__pycache__/
*.py[cod]

# Python build artifacts and resumable dependency downloads
build/
dist/
.downloads/
*.spec.bak

# Virtual environments and local IDE settings
.venv/
.uv-cache/
.test-tmp/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.idea/
.vscode/
.vs/
**/x64/
*.user
*.user.props
!*.user.props.template

# C/C++ and Visual Studio build outputs
frontend/**/bin/
frontend/**/obj/
*.obj
*.pdb
*.iobj
*.ipdb
*.ilk
*.exp
*.lib

# Rebuildable datasets and generated results. Source videos, imported labels and
# model artifacts are versioned through Git LFS so a fresh clone can reproduce
# the current projects.
datasets/**
outputs/**
runs/**
/yolo26n.pt

# Per-project rebuildable training artifacts
projects/*/frames/**
projects/*/dataset/**
projects/*/runs/**
projects/*/outputs/**
projects/*/frames_manifest.json
projects/*/annotation_import_report.json

# OS and editor temporary files
.DS_Store
Thumbs.db
*.tmp
*.log
*.rar
*.lnk
